<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- #1311: the sound preview player (SLPanelSoundPlayer), used by floater_preview_sound.xml and
     floater_sound_preview.xml. Included at any width: the bar stretches, Loop stays right. -->
<panel
 name="sound_player"
 class="sound_player"
 layout="topleft"
 follows="left|top|right"
 width="280"
 height="56">
    <string name="play_sound">Play Locally</string>
    <string name="play_sound_tip">Play this sound so that only you can hear it. You hear exactly what plays in-world, including the very short fade in and out the viewer adds at its start and end.</string>
    <string name="play_file">Play</string>
    <string name="play_file_tip">Play the file as it was decoded for upload. Only you hear it.</string>
    <string name="pause">Pause</string>
    <string name="time">[POSITION] / [LENGTH]</string>
    <string name="loading">Loading...</string>
    <string name="unavailable">Could not load this sound</string>
    <string name="blocked">This sound is blocked</string>
    <string name="no_audio">No audio device</string>
    <sound_scrub_bar
     name="scrub_bar"
     layout="topleft"
     follows="left|top|right"
     left="0"
     top="0"
     width="280"
     height="28"
     tool_tip="Click to jump to a point, or drag the playhead and let go to jump there" />
    <button
     name="play_btn"
     layout="topleft"
     follows="left|top"
     left="0"
     top_pad="6"
     width="100"
     height="22"
     label="Play"
     sound_flags="0" />
    <text
     name="time_text"
     type="string"
     layout="topleft"
     follows="left|top"
     font="SansSerifSmall"
     left_pad="8"
     top_delta="4"
     width="110"
     height="14"
     mouse_opaque="false" />
    <check_box
     name="loop_check"
     layout="topleft"
     follows="right|top"
     label="Loop"
     tool_tip="Play the sound over and over"
     left="218"
     top_delta="-2"
     width="62"
     height="18" />
</panel>
