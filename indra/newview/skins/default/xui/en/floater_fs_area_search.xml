                 layout="topleft"
                 left="4"
                 name="more_filters_btn"
                 tool_tip="Permissions, probes, child prims, price and click action."
                 top="393"
                 width="186" />
                <panel
                 follows="left|top"
                 height="166"
                 layout="topleft"
                 left="0"
                 name="more_filters_panel"
                 top="419"
                 visible="false"
                 width="198">
                    <text
                     follows="left|top"
                     height="16"
                     layout="topleft"
                     left="8"
