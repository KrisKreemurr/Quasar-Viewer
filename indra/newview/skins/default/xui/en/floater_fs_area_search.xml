        <layout_panel
         name="list_layout"
         auto_resize="true"
         user_resize="false"
         width="590">
            <panel
             name="area_search_list_panel"
             follows="all"
             layout="topleft"
             left="0"
             top="0"
             width="590"
             height="436">
                <panel.string name="counter_blank"></panel.string>
                <panel.string name="counter_format">[LISTED] objects · [PENDING] still loading</panel.string>
