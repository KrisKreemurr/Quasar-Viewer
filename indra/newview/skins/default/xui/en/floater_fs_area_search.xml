                 name="list_stack"
                 follows="all"
                 layout="topleft"
                 left="0"
                 top="0"
                 width="590"
                 height="436"
                 orientation="vertical">
                    <layout_panel
                     name="parcel_summary_panel"
                     auto_resize="false"
                     user_resize="false"
                     height="52">
                        <text
                         follows="left|top|right"
                         font="SansSerifBold"
                         height="16"
                         layout="topleft"
                         left="4"
                         name="parcel_name"
                         top="2"
                         use_ellipses="true"
                         width="250" />
                        <text
                         follows="top|right"
                         halign="right"
                         height="16"
                         layout="topleft"
                         left="-336"
                         name="parcel_pool"
                         tool_tip="This owner's parcels in the region share one land impact limit."
                         top="2"
                         visible="false"
                         width="176" />
                        <text
                         follows="top|right"
                         font="SansSerifBold"
                         halign="right"
                         height="16"
                         layout="topleft"
