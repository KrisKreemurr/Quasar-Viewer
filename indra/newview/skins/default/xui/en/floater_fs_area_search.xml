    <floater.string name="parcel_loading">...</floater.string>
    <floater.string name="unnamed_parcel">(unnamed parcel)</floater.string>
    <floater.string name="parcel_name">[NAME]   [AREA] m²</floater.string>
    <floater.string name="parcel_used">[USED] of [CAPACITY] LI</floater.string>
