                    </text>
                    <combo_box
                     follows="left|top"
                     height="20"
                     layout="topleft"
                     left="102"
                     name="tri_transfer"
                     tool_tip="Objects their owner can give away."
                     top="44"
                     width="88">
                        <combo_box.item label="Any" name="any" value="0"/>
                        <combo_box.item label="Only" name="only" value="1"/>
                        <combo_box.item label="Hide" name="hide" value="2"/>
                    </combo_box>
