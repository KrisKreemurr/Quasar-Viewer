                     height="16"
                     layout="topleft"
                     left="8"
                     name="price_label"
                     top="115"
                     width="40">
                        Price
                    </text>
                    <spinner
                     decimal_digits="0"
                     follows="left|top"
                     height="18"
                     increment="10"
                     label_width="0"
