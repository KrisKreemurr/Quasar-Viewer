<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- Kill feed settings with a live preview (CombatFX). Ported from GunMetal-DX (squeedledorf,
     LGPL 2.1), v0.3.0 cf5f1f4 (SoapStorm's kill feed); fewer settings. -->
<floater
 positioning="cascading"
 can_minimize="false"
 can_resize="false"
 height="200"
 layout="topleft"
 name="floater_fs_kill_feed"
 save_rect="true"
 single_instance="true"
 title="KILL FEED"
 width="320">
    <check_box
     control_name="FSKillFeedEnabled"
     follows="left|top"
     layout="topleft"
     left="12"
     top="26"
     height="16"
     width="296"
     label="Enable kill feed overlay"
     tool_tip="Listen to the region combat log (Combat 2.0) and show kills as text on screen. Wears the small #Slipstream Helper object while on." />
    <slider
     control_name="FSKillFeedTextScale"
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="10"
     height="15"
     width="296"
     label="Text size:"
     label_width="110"
     min_val="0.5"
     max_val="2.5"
     increment="0.05"
     decimal_digits="2"
     can_edit_text="true"
     show_text="true" />
    <slider
     control_name="FSKillFeedScreenX"
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="6"
     height="15"
     width="296"
     label="Horizontal:"
     label_width="110"
     min_val="0.0"
     max_val="1.0"
     increment="0.01"
     decimal_digits="2"
     show_text="true"
     tool_tip="Overlay position across the screen (0 = left, 1 = right)" />
    <slider
     control_name="FSKillFeedScreenY"
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="6"
     height="15"
     width="296"
     label="Vertical:"
     label_width="110"
     min_val="0.0"
     max_val="1.0"
     increment="0.01"
     decimal_digits="2"
     show_text="true"
     tool_tip="Overlay position up the screen (0 = bottom, 1 = top)" />
    <slider
     control_name="FSKillFeedMaxLines"
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="6"
     height="15"
     width="296"
     label="Lines:"
     label_width="110"
     min_val="1"
     max_val="10"
     increment="1"
     decimal_digits="0"
     show_text="true"
     tool_tip="Maximum kills shown at once" />
    <slider
     control_name="FSKillFeedHoldTime"
     follows="left|top"
     layout="topleft"
     left="12"
     top_pad="6"
     height="15"
     width="296"
     label="Hold (sec):"
     label_width="110"
     min_val="0"
     max_val="120"
     increment="1"
     decimal_digits="0"
     show_text="true"
     tool_tip="How long each kill stays on screen (0 = never fade)" />
</floater>
