<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- *NOTE: See also menu_pie_attachment_other.xml -->

<pie_menu
    name="Avatar Pie">
    <pie_slice
        label="Profile..."
        name="Profile...">
        <pie_slice.on_click
            function="ShowAgentProfile"
            parameter="hit object" />
        <pie_slice.on_enable
            function="RLV.CanShowName" />
    </pie_slice>
    <pie_menu
        name="mute_menu"
        label="Manage &gt;">
        <pie_slice
            enabled="true"
            label="Mute"
            name="Avatar Mute">
            <pie_slice.on_click
                function="Avatar.Mute" />
<!--        <pie_slice.on_enable
                    function="Avatar.EnableMute" /> -->
        </pie_slice>
        <pie_slice
            enabled="false"
            label="Part. Owner"
            name="Mute Particle">
            <pie_slice.on_click
                function="Particle.Mute" />
            <pie_slice.on_enable
                function="EnableMuteParticle" />
        </pie_slice>
        <!-- Ported from GunMetal-DX (squeedledorf, LGPL 2.1), v0.3.0 cf5f1f4: sound emitter blacklist, shown with SLSoundEmitterBlacklist -->
        <pie_slice
            enabled="true"
            label="Sound Emitter"
            name="BlacklistSoundEmitter">
            <pie_slice.on_click
                function="Object.BlacklistSoundEmitter" />
            <pie_slice.on_visible
                function="Object.SoundEmitterBlacklistEnabled" />
        </pie_slice>
        <pie_slice
            enabled="true"
            label="Sound (Perm)"
            name="BlacklistSoundEmitterPermanent">
            <pie_slice.on_click
                function="Object.BlacklistSoundEmitterPermanent" />
            <pie_slice.on_visible
                function="Object.SoundEmitterBlacklistEnabled" />
        </pie_slice>
        <!-- </GMDX> -->
        <pie_slice
            label="Freeze"
            name="Freeze...">
            <pie_slice.on_click
                function="Avatar.Freeze" />
            <pie_slice.on_visible
                function="Avatar.EnableFreezeEject"/>
        </pie_slice>
        <pie_slice
            label="Parcel Eject"
            name="Eject..."
            tool_tip="Eject from the parcel. A ban is a separate choice in the confirmation.">
            <pie_slice.on_click
                function="Avatar.Eject" />
            <pie_slice.on_visible
                function="Avatar.EnableFreezeEject"/>
        </pie_slice>
        <!-- Slipstream: the estate actions (shown to estate managers) in their own ring -->
        <pie_menu
            name="estate_menu"
            label="Estate &gt;">
            <pie_slice
                label="Send Home"
                name="Teleport Home..."
                tool_tip="Remove from the region by sending home, without adding a ban.">
                <pie_slice.on_click
                    function="Avatar.ManageEstate"
                    parameter="0" />
                <pie_slice.on_visible
                    function="Avatar.EnableManageEstate" />
            </pie_slice>
            <pie_slice
                label="Estate Kick"
                name="Estate Kick...">
                <pie_slice.on_click
                    function="Avatar.ManageEstate"
                    parameter="1" />
                <pie_slice.on_visible
                    function="Avatar.EnableManageEstate" />
            </pie_slice>
            <pie_slice
                label="Estate Ban"
                name="Estate Ban...">
                <pie_slice.on_click
                    function="Avatar.ManageEstate"
                    parameter="2" />
                <pie_slice.on_visible
                    function="Avatar.EnableManageEstate" />
            </pie_slice>
        </pie_menu>
    </pie_menu>
    <pie_slice
        enabled="true"
        label="Go to"
        name="Go to">
        <pie_slice.on_click
            function="GoToObject" />
    </pie_slice>
    <pie_slice
        label="Report..."
        name="abuse">
        <pie_slice.on_click
            function="Avatar.ReportAbuse" />
    </pie_slice>
    <pie_menu
        label="Add &gt;"
        name="add_avatar">
        <pie_separator/>
        <pie_separator/>
        <pie_separator/>
        <pie_separator/>
        <pie_slice
            enabled="false"
            label="As Friend..."
            name="Add Friend">
            <pie_slice.on_click
                function="Avatar.AddFriend" />
            <pie_slice.on_enable
                function="Avatar.EnableAddFriend" />
        </pie_slice>
        <pie_slice
            label="To Set..."
            name="Add to set">
            <pie_slice.on_click
                function="Avatar.AddToContactSet" />
            <pie_slice.on_enable
                function="RLV.CanShowName" />
        </pie_slice>
    </pie_menu>
    <pie_slice
        enabled="false"
        label="Pay..."
        name="Pay...">
        <pie_slice.on_click
            function="PayObject" />
        <pie_slice.on_enable
            function="EnablePayAvatar" />
    </pie_slice>
    <pie_menu
        name="Avatar Pie More 1"
        label="More &gt;">

        <!-- Slipstream: Freeze, Parcel Eject and the estate actions (#1250) are under Manage > -->
        <pie_slice
            label="Teleport To"
            name="Teleport To">
            <pie_slice.on_click
                function="Avatar.TeleportTo" />
            <pie_slice.on_enable
                function="Avatar.EnableTeleportTo" />
        </pie_slice>
        <pie_slice
            label="Give Card"
            name="Give Calling Card">
            <pie_slice.on_click
                function="Avatar.GiveCard" />
            <pie_slice.on_enable
                function="RLV.CanShowName" />
        </pie_slice>
        <pie_slice
            label="Invite to Group"
            name="Group Invite...">
            <pie_slice.on_click
                function="Avatar.InviteToGroup" />
            <pie_slice.on_enable
                function="RLV.CanShowName" />
        </pie_slice>

<!-- [FS:Chanayane] Compass floater - face towards avatar from pie menu -->
        <pie_slice
            label="Face towards"
            name="Face towards">
            <pie_slice.on_click
                function="Avatar.FaceTowards" />
            <pie_slice.on_enable
                function="Avatar.CanFaceTowards" />
        </pie_slice>
<!-- [/FS:Chanayane] -->

        <pie_menu
            name="copy_menu"
            label="Copy &gt;">
            <pie_slice
                label="Full Name"
                name="copy_full_name">
                <pie_slice.on_click
                    function="Avatar.CopyData"
                    parameter="full_name" />
                <pie_slice.on_enable
                    function="RLV.CanShowName" />
            </pie_slice>
            <pie_slice
                label="Display Name"
                name="copy_display_name">
                <pie_slice.on_click
                    function="Avatar.CopyData"
                    parameter="display_name" />
                <pie_slice.on_enable
                    function="RLV.CanShowName" />
            </pie_slice>
            <pie_slice
                label="Agent Name"
                name="copy_username">
                <pie_slice.on_click
                    function="Avatar.CopyData"
                    parameter="user_name" />
                <pie_slice.on_enable
                    function="RLV.CanShowName" />
            </pie_slice>
            <pie_slice
                label="SLurl"
                name="copy_slurl">
                <pie_slice.on_click
                    function="Avatar.CopyData"
                    parameter="slurl" />
                <pie_slice.on_enable
                    function="RLV.CanShowName" />
            </pie_slice>
            <pie_slice
                label="UUID"
                name="Copy ID">
                <pie_slice.on_click
                    function="Avatar.CopyData"
                    parameter="id" />
            </pie_slice>
        </pie_menu>

        <pie_menu
            name="Avatar Pie More 2"
            label="More &gt;">

            <!-- ## Zi: Is this the right thing to use for avatar textures? -->
            <pie_slice
                label="Textures"
                name="Debug...">
                <pie_slice.on_click
                    function="Avatar.Debug" />
            </pie_slice>
            <pie_slice
                label="Script Info"
                name="ScriptInfo">
                <pie_slice.on_click
                    function="Tools.ScriptInfo" />
                <pie_slice.on_enable
                    function="Object.EnableScriptInfo" />
            </pie_slice>
            <pie_slice
                label="Call"
                name="Call">
                <pie_slice.on_click
                    function="Avatar.Call" />
                <pie_slice.on_enable
                    function="Avatar.EnableCall" />
            </pie_slice>
            <pie_slice
                label="Zoom In"
                name="Zoom In">
                <pie_slice.on_click
                    function="Tools.LookAtSelection"
                    parameter="zoom" />
            </pie_slice>
            <pie_slice
                enabled="true"
                label="Tex Refresh"
                name="Texture Refresh">
                <pie_slice.on_click
                    function="Avatar.RefreshTexture" />
            </pie_slice>
			<pie_menu
				name="ResetMenu"
				label="Reset &gt;">
				<pie_slice
					label="Skel. &amp; Anim."
					name="Reset Skeleton And Animations">
					<pie_slice.on_click
						function="Avatar.ResetSkeletonAndAnimations" />
				</pie_slice>
				<pie_slice
					label="Skeleton"
					name="Reset Skeleton">
					<pie_slice.on_click
						function="Avatar.ResetSkeleton" />
				</pie_slice>
				<pie_slice
					label="Anims"
					name="Refresh Animations">
					<pie_slice.on_click
						function="Avatar.RefreshAnimations" />
				</pie_slice>
				<pie_slice
					label="Mesh LOD"
					name="Reset Mesh LOD">
					<pie_slice.on_click
						function="Avatar.ResetMeshLOD" />
				</pie_slice>
			</pie_menu>
			<pie_slice
				label="Dump XML"
				name="Dump XML">
				<pie_slice.on_click
					function="Advanced.AppearanceToXML" />
				<pie_slice.on_visible
					function="Advanced.EnableAppearanceToXML"/>
			</pie_slice>
			<pie_menu
				name="RenderMenu"
				label="Display &gt;">
				<pie_slice
					name="RenderNormally"
					label="Normally">
					<pie_slice.on_click
						function="Avatar.SetImpostorMode"
						parameter="0" />
					<pie_slice.on_visible
						function="Avatar.CheckImpostorMode"
						parameter="4" />
				</pie_slice>
				<pie_slice
					name="DoNotRender"
					label="Never">
					<pie_slice.on_click
						function="Avatar.SetImpostorMode"
						parameter="1" />
				</pie_slice>
				<pie_slice
					name="AlwaysRenderFully"
					label="Fully">
					<pie_slice.on_click
						function="Avatar.SetImpostorMode"
						parameter="2" />
				</pie_slice>
				<pie_slice
				    label="Cel Shade"
				    name="Cel Shade Avatar">
				    <pie_slice.on_click
				        function="Avatar.CelShadeToggle" />
				</pie_slice>
				<pie_slice
				    label="Exceptions..."
				    name="RenderExceptions">
				    <pie_slice.on_click
				        function="View.Blocked"
				        parameter="avatar_rendering_tab" />
				</pie_slice>
			</pie_menu>
        </pie_menu>

        <pie_separator />
        <pie_menu
            name="DerenderMenu"
            label="Derender &gt;">
			<pie_separator />
			<pie_separator />
			<pie_separator />
			<pie_separator />
			<pie_separator />
			<pie_separator />
			<pie_slice
				enabled="true"
				label="Blacklist"
				name="DerenderPermanent">
				<pie_slice.on_click
					function="Avatar.Derender" parameter="persistent" />
				<pie_slice.on_enable
					function="Avatar.EnableDerender" />
			</pie_slice>
			<pie_slice
				enabled="true"
				label="Temporary"
				name="Derender">
				<pie_slice.on_click
					function="Avatar.Derender" parameter="temporary" />
				<pie_slice.on_enable
					function="Avatar.EnableDerender" />
			</pie_slice>
        </pie_menu>

    </pie_menu>

    <pie_slice
        label="IM"
        name="Send IM...">
        <pie_slice.on_click
            function="Avatar.SendIM" />
        <pie_slice.on_enable
            function="RLV.CanShowName" />
    </pie_slice>

</pie_menu>
