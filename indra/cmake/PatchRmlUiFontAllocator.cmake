# Owner-approved #703 local modification of MIT RmlUi 6.3. Only font blur/glow
# scratch arrays use this internal allocator. Apply to the fetched BUILD copy.
set(_header "${RMLUI_SOURCE_DIR}/Source/Core/Memory.h")
file(SHA256 "${_header}" _before)
set(_original f8fbcce5441983553cabcdf2cf5e21cc2430252d64949551c36ebe7668be0b66)
set(_patched 946134f7307ae81bc6ad58e25a3177f0fcb24767d5ebe9faaa7d0d344f942d2b)
if(_before STREQUAL _patched)
  return()
endif()
if(NOT _before STREQUAL _original)
  message(FATAL_ERROR "RmlUi allocator patch requires the pinned, unmodified 6.3 Memory.h")
endif()
set(_patch "${CMAKE_CURRENT_LIST_DIR}/patches/rmlui-6.3-checked-font-scratch.patch")
file(SHA256 "${_patch}" _patch_hash)
if(NOT _patch_hash STREQUAL "063da562bf3585e77b99b624f54133c8cace917514ebf3dc9d35871d327c7f5b")
  message(FATAL_ERROR "RmlUi allocator patch changed: review and update its audited digest")
endif()
find_program(_patch_tool patch REQUIRED)
execute_process(COMMAND "${_patch_tool}" --batch --forward -p1 --input "${_patch}"
    WORKING_DIRECTORY "${RMLUI_SOURCE_DIR}" RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Could not apply the pinned RmlUi font allocator patch")
endif()
file(SHA256 "${_header}" _after)
if(NOT _after STREQUAL _patched)
  message(FATAL_ERROR "Unexpected RmlUi Memory.h after the allocator patch")
endif()
